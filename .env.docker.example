# Copy to .env and fill in, then: docker compose up -d --build
#
# openssl rand -base64 32
AUTH_SECRET=
# The code you type once per new device before creating a passkey there.
ACCESS_CODE=

# Optional — leave blank to disable the /api/v1/* bearer-token API.
API_TOKEN=
APP_USER_NAME=Sameer
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Optional — override the Postgres password (default: onyx) and the host
# port the app listens on (default: 3000).
POSTGRES_PASSWORD=
APP_PORT=
