# ── Required ────────────────────────────────────────────────────────────────
# Long random string used to sign the session cookie:  openssl rand -base64 32
AUTH_SECRET=
# The code you type once on a new device before creating a passkey there.
ACCESS_CODE=

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty for local dev (an embedded Postgres is used, stored in .data/).
# In production this is set for you by docker-compose; only fill it in if you
# are pointing the app at a Postgres you run elsewhere.
DATABASE_URL=

# ── Optional ────────────────────────────────────────────────────────────────
# Bearer token for the read-only /api/v1/* endpoints (widgets, shortcuts).
API_TOKEN=
APP_USER_NAME=Sameer
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
